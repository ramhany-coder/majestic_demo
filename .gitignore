# Environments
.venv/
venv/
env/
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Jupyter
.ipynb_checkpoints/

# Streamlit: config.toml is committed, secrets never are.
.streamlit/secrets.toml

# Runtime-downloaded model cache markers (config.PII_SPACY_MODEL_DIR) -- must
# never be committed, or a fresh clone/container would wrongly believe the
# model is already installed and skip downloading it. See model_manager.py.
models/pii_spacy/

# Embedding model downloaded once by model_manager.ensure_hf_model_downloaded
# (config.RETRIEVAL_EMBEDDING_MODEL_DIR). Same rule: a committed marker without
# the model files would skip a download that is still needed.
models/embeddings/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Pickled search-engine indices (agents/meta_data_fiter/engine_registry.py) --
# rebuilt automatically from data/egyptian-drugs.json when missing or stale.
cache/
