# Z.ai GLM key -- every LLM call routes to zai:glm-5.3-flash by default.
ZAI_API_KEY=
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4/   # or https://open.bigmodel.cn/api/paas/v4/ for a BigModel key
# Hidden per-request switch (?llm=glm | ?llm=groq on the widget, console or Streamlit
# app; "llm" on POST /chat): that turn's LLM calls use these [primary, fallback] routes.
# GLM_PRIMARY_ROUTE=zai:glm-5.3-flash
# GLM_FALLBACK_ROUTE=zai:glm-5.3-flash
# GROQ_PRIMARY_ROUTE=groq:qwen/qwen3.8-27b
# GROQ_FALLBACK_ROUTE=groq:openai/gpt-oss-20b
ANTHROPIC_API_KEY=
GROQ_API=
GPT_API=
GEMINI_API=
OLLAMA_PATH=http://localhost:11434

# Metadata filter extractor (agents/filter_extractor) -- all optional.
EXTRACTOR_PRIMARY_ROUTE=zai:glm-5.3-flash
EXTRACTOR_FALLBACK_ROUTE=zai:glm-5.3-flash
EXTRACTOR_USE_FALLBACK_MODEL=true
EXTRACTOR_USE_RULE_FALLBACK=true
EXTRACTOR_TIMEOUT_S=4.0
EXTRACTOR_FALLBACK_TIMEOUT_S=4.0
EXTRACTOR_CALL_DEADLINE_S=8.0
EXTRACTOR_TRANSLATE=false  # standalone use only; the chat pipeline uses the prequal rewriter
EXTRACTOR_ALLOWED_IN_PROMPT=true
EXTRACTOR_CACHE_TTL_S=86400
# EXTRACTOR_MAX_TOKENS={"ingredients": 120}
# EXTRACTOR_CALL_TIMEOUTS={"ingredients": 3.0}

# Pre-qualification stage (agents/prequal) -- all optional; routes default to the EXTRACTOR_* routes.
# PREQUAL_PRIMARY_ROUTE=zai:glm-5.3-flash
# PREQUAL_FALLBACK_ROUTE=zai:glm-5.3-flash
PREQUAL_USE_FALLBACK_MODEL=true
PREQUAL_REWRITER_MAX_TOKENS=120
PREQUAL_ROUTER_MAX_TOKENS=40
PREQUAL_REWRITER_TIMEOUT_S=4.0
PREQUAL_ROUTER_TIMEOUT_S=4.0
PREQUAL_FALLBACK_TIMEOUT_S=4.0
PREQUAL_REWRITER_DEADLINE_S=8.0
PREQUAL_ROUTER_DEADLINE_S=8.0
PREQUAL_HISTORY_MESSAGES=6
PREQUAL_HISTORY_USER_CHARS=300
PREQUAL_HISTORY_ASSISTANT_CHARS=150
PREQUAL_LAST_PRODUCTS=5
PREQUAL_CACHE_TTL_S=300
PREQUAL_SPECULATIVE_EXTRACTOR=false
PREQUAL_ROUTE_FROM_INTENT=true

# Retrieval (agents/retrieval) -- all optional.
RETRIEVAL_K_DEFAULT=10
RETRIEVAL_K_MAX=20
RETRIEVAL_BM25_K1=1.2
RETRIEVAL_BM25_B=0.3
RETRIEVAL_NAME_REL_SCORE=0.8
RETRIEVAL_NAME_DICE_MIN=0.45
RETRIEVAL_NAME_MAX_HITS=10
RETRIEVAL_FILL_INTENTS=find_products,refine_products
RETRIEVAL_BUNDLE_RULE=true
RETRIEVAL_ALL_SKIN_TYPES_MATCH=true
RETRIEVAL_FORM_VARIANTS=true
RETRIEVAL_RELAX_FILTERS=false
# RETRIEVAL_FUSION_WEIGHTS={"best_seller": 0.05}
RETRIEVAL_SEMANTIC_ENABLED=true
RETRIEVAL_EMBEDDING_ROUTE=hf:sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_EMBEDDING_MODEL_DIR=models/embeddings
RETRIEVAL_SEMANTIC_TIMEOUT_S=1.5
RETRIEVAL_MODEL_INIT_TIMEOUT_S=60

# Sessions
SESSION_TTL_S=86400

# Jamila widget (web/, api/chat.py, streamlit_app.py) -- all optional.
# Origins allowed to call /chat from a browser, comma-separated (the storefront's app embed).
# CORS_ALLOW_ORIGINS=https://e-majestic.com
# Height of the widget's frame in the Streamlit app, in pixels.
# JAMILA_FRAME_HEIGHT=720
