ANTHROPIC_API_KEY=
GROQ_API=
GPT_API=
GEMINI_API=
OLLAMA_PATH=http://localhost:11434

# Metadata filter extractor (agents/filter_extractor) -- all optional.
EXTRACTOR_PRIMARY_ROUTE=groq:qwen/qwen3.8-27b
EXTRACTOR_FALLBACK_ROUTE=groq:openai/gpt-oss-20b
EXTRACTOR_USE_FALLBACK_MODEL=true
EXTRACTOR_USE_RULE_FALLBACK=true
EXTRACTOR_TIMEOUT_S=2.5
EXTRACTOR_FALLBACK_TIMEOUT_S=2.5
EXTRACTOR_CALL_DEADLINE_S=4.5
EXTRACTOR_TRANSLATE=false  # standalone use only; the chat pipeline uses the prequal rewriter
EXTRACTOR_ALLOWED_IN_PROMPT=true
EXTRACTOR_CACHE_TTL_S=86400
# EXTRACTOR_MAX_TOKENS={"ingredients": 120}
# EXTRACTOR_CALL_TIMEOUTS={"ingredients": 3.0}

# Pre-qualification stage (agents/prequal) -- all optional; routes default to the EXTRACTOR_* routes.
# PREQUAL_PRIMARY_ROUTE=groq:qwen/qwen3.8-27b
# PREQUAL_FALLBACK_ROUTE=groq:openai/gpt-oss-20b
PREQUAL_USE_FALLBACK_MODEL=true
PREQUAL_REWRITER_MAX_TOKENS=120
PREQUAL_ROUTER_MAX_TOKENS=40
PREQUAL_REWRITER_TIMEOUT_S=2.0
PREQUAL_ROUTER_TIMEOUT_S=1.5
PREQUAL_FALLBACK_TIMEOUT_S=2.0
PREQUAL_REWRITER_DEADLINE_S=3.5
PREQUAL_ROUTER_DEADLINE_S=3.0
PREQUAL_HISTORY_MESSAGES=6
PREQUAL_HISTORY_USER_CHARS=300
PREQUAL_HISTORY_ASSISTANT_CHARS=150
PREQUAL_LAST_PRODUCTS=5
PREQUAL_CACHE_TTL_S=300
PREQUAL_SPECULATIVE_EXTRACTOR=false
PREQUAL_ROUTE_FROM_INTENT=true

# Orchestrator
RETRIEVAL_TOP_K=5
SESSION_TTL_S=86400
